#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

choice="$(printf '%s\n' 'Snake' 'Space Invaders' 'Tetris' 'Pong' | fzf --height=40% --reverse --prompt='Game > ')"

case "$choice" in
    Snake) exec cargo run --example snake ;;
    'Space Invaders') exec cargo run --example space_invaders ;;
    Tetris) exec cargo run --example tetris ;;
    Pong) exec cargo run --example pong ;;
    '') exit 0 ;;
esac
